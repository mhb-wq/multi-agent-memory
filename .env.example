# Set these in the process environment. No real credential belongs in this file.
OURS_LLM_MODEL=deepseek-flash
OURS_LLM_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
# Configure your chosen OpenAI-compatible embedding endpoint explicitly.
OURS_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OURS_EMBEDDING_BASE_URL=http://127.0.0.1:8091/v1
OURS_EMBEDDING_DIMS=384
OURS_EMBEDDING_API_KEY=
# Generate a distinct random token, at least 24 characters, for each trusted runner.
OURS_MARCUS_TOKEN=
OURS_PATEL_TOKEN=
OURS_NINA_TOKEN=
OURS_MARTHA_TOKEN=
NO_PROXY=127.0.0.1,localhost
